# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
APP_NAME=AuthCore
APP_VERSION=1.0.0
PORT=3001
API_PREFIX=/api/v1
# URL do frontend usada nos links de e-mail (verificacao e redefinicao)
FRONTEND_URL=http://localhost:3000

# ============================================
# SECURITY
# ============================================
# Gere segredos fortes e distintos (min. 64 caracteres):
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_generate_64_bytes_hex_access_secret_min_64_chars_long
JWT_REFRESH_SECRET=CHANGE_ME_generate_64_bytes_hex_refresh_secret_distinct_value
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
BCRYPT_ROUNDS=12
# Chave de exatamente 32 caracteres:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_exactly_32_characters_

# ============================================
# DATABASE
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=enterprise_db
DB_USER=enterprise_user
DB_PASSWORD=your-strong-db-password
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_TTL=3600

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ============================================
# CORS
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM=noreply@yourdomain.com

# ============================================
# STORAGE
# ============================================
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_DIR=./logs
